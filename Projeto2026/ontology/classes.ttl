@prefix : <http://rpcw.di.uminho.pt/2026/minecraft/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://rpcw.di.uminho.pt/2026/minecraft/> .

<http://rpcw.di.uminho.pt/2026/minecraft> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://rpcw.di.uminho.pt/2026/minecraft/IsaBlockStateOf
:IsaBlockStateOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :hasBlockState .


###  http://rpcw.di.uminho.pt/2026/minecraft/applicableTo
:applicableTo rdf:type owl:ObjectProperty ;
              owl:inverseOf :canBeEnchantedWith ;
              rdfs:domain :Enchantment ;
              rdfs:range :Item .


###  http://rpcw.di.uminho.pt/2026/minecraft/breedsWith
:breedsWith rdf:type owl:ObjectProperty ;
            rdfs:domain :PassiveMob ;
            rdfs:range :Item .


###  http://rpcw.di.uminho.pt/2026/minecraft/canBeEnchantedWith
:canBeEnchantedWith rdf:type owl:ObjectProperty ;
                    rdfs:domain :Item ;
                    rdfs:range :Enchantment .


###  http://rpcw.di.uminho.pt/2026/minecraft/canBurnIn
:canBurnIn rdf:type owl:ObjectProperty ;
           owl:inverseOf :usesFuel ;
           rdfs:domain :Item ;
           rdfs:range :FunctionalBlock .


###  http://rpcw.di.uminho.pt/2026/minecraft/canMine
:canMine rdf:type owl:ObjectProperty ;
         owl:inverseOf :minedWith ;
         rdfs:domain :Tool ;
         rdfs:range :Block .


###  http://rpcw.di.uminho.pt/2026/minecraft/contains
:contains rdf:type owl:ObjectProperty ;
          owl:inverseOf :locatedIn ;
          rdf:type owl:TransitiveProperty ;
          rdfs:domain :Environment ;
          rdfs:range :GameObject .


###  http://rpcw.di.uminho.pt/2026/minecraft/containsItem
:containsItem rdf:type owl:ObjectProperty ;
              owl:inverseOf :storedIn ;
              rdfs:domain :Container ;
              rdfs:range :Item .


###  http://rpcw.di.uminho.pt/2026/minecraft/craftedBy
:craftedBy rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :obtainedFrom ;
           owl:inverseOf :produces ;
           rdfs:domain :Item ;
           rdfs:range :Recipe .


###  http://rpcw.di.uminho.pt/2026/minecraft/droppedBy
:droppedBy rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :obtainedFrom ;
           owl:inverseOf :drops ;
           rdfs:domain :Item ;
           rdfs:range :Mob .


###  http://rpcw.di.uminho.pt/2026/minecraft/drops
:drops rdf:type owl:ObjectProperty ;
       rdfs:domain :Mob ;
       rdfs:range :Item .


###  http://rpcw.di.uminho.pt/2026/minecraft/foundIn
:foundIn rdf:type owl:ObjectProperty ;
         rdfs:domain :GameObject ;
         rdfs:range :Environment .


