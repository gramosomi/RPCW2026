:Block a owl:Class ;
    rdfs:subClassOf :GameObject .

:ShapedRecipe a owl:Class ;
    rdfs:subClassOf :CraftingRecipe ;
    owl:disjointWith :ShapelessRecipe .

:Item a owl:Class ;
    rdfs:subClassOf :GameObject .

:CraftingRecipe a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "9"^^xsd:nonNegativeInteger ;
            owl:onClass :Item ;
            owl:onProperty :hasIngredient ],
        :Recipe .

:Recipe a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Item ;
            owl:onProperty :hasIngredient ],
        [ a owl:Restriction ;
            owl:onClass :Item ;
            owl:onProperty :produces ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:BlockState a owl:Class .

:RecipeSlot a owl:Class ;
    rdfs:comment "Um slot específico na grelha de crafting (3x3)." .

