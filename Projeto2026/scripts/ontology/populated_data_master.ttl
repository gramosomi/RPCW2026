:acacia_leaves a :Block,
        :Item ;
    :blastResistance "0.2"^^xsd:float ;
    :boundingBox "block"^^xsd:string ;
    :defaultStateId 391 ;
    :emitLight 0 ;
    :filterLight 1 ;
    :hardness "0.2"^^xsd:float ;
    :hasBlockState :acacia_leaves_state_distance,
        :acacia_leaves_state_persistent,
        :acacia_leaves_state_waterlogged ;
    :hasDisplayName "Acacia Leaves"^^xsd:string ;
    :hasID 92,
        186 ;
    :hasName "acacia_leaves"^^xsd:string ;
    :isDiggable true ;
    :isTransparent true ;
    :materialCategory "leaves;mineable/hoe"^^xsd:string ;
    :maxStateId 391 ;
    :minStateId 364 ;
    :stackSize 64 .

