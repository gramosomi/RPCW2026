:FunctionalBlock a owl:Class ;
    rdfs:subClassOf :Block .

:PassiveMob a owl:Class ;
    rdfs:subClassOf :Mob .

:Recipe a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Item ;
            owl:onProperty :hasIngredient ],
        [ a owl:Restriction ;
            owl:onClass :Item ;
            owl:onProperty :produces ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

