:Container a owl:Class ;
    rdfs:subClassOf :Item .

:CraftingRecipe a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "9"^^xsd:nonNegativeInteger ;
            owl:onClass :Item ;
            owl:onProperty :hasIngredient ],
        :Recipe .

:DurabilityEnchantment a owl:Class ;
    rdfs:subClassOf :Enchantment .

:EquippableEnchantment a owl:Class ;
    rdfs:subClassOf :Enchantment .

:FishingEnchantment a owl:Class ;
    rdfs:subClassOf :Enchantment .

:Head_armorEnchantment a owl:Class ;
    rdfs:subClassOf :ArmorEnchantment .

:MaterialTier a owl:Class .

:Melee_weaponEnchantment a owl:Class ;
    rdfs:subClassOf :WeaponEnchantment .

:MiningEnchantment a owl:Class ;
    rdfs:subClassOf :Enchantment .

:Mining_lootEnchantment a owl:Class ;
    rdfs:subClassOf :MiningEnchantment .

:Ore a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :NaturalBlock [ a owl:Restriction ;
                        owl:allValuesFrom :Pickaxe ;
                        owl:onProperty :minedWith ] ) ] .

